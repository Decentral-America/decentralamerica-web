# Serves the prerendered site in the Railway image.
#
# Railway terminates TLS at its edge and forwards plain HTTP to $PORT, so this
# listens on a port rather than a hostname and leaves certificates alone.
#
# The point of running our own server is the last block. Railway's static
# provider serves this site with a single-page-app fallback, which answers 200
# with the home page for every path that does not exist. Every typo, every dead
# inbound link and every stale URL then looks like a real page to a crawler.
# Each route here is a real prerendered file, so a miss is a miss.

{
	admin off
	auto_https off
	persist_config off
	log {
		format console
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Vite fingerprints these, so the name changes whenever the bytes do.
	@fingerprinted path /assets/*
	header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

	# Stable names that in practice never change.
	@fonts path /fonts/* /home/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	# Stable names that do change: the share cards are redrawn by `pnpm og` and
	# the scroll page's css and js are hand-edited. A year would pin a stale card
	# in every crawler that had seen it.
	@redrawn path /og/* /home/*.css /home/*.js /brand/*
	header @redrawn Cache-Control "public, max-age=86400"

	# /evidencia is proxied and sets its own caching, which is shorter-lived than
	# a prerendered page and longer-lived than must-revalidate.
	@html not path /assets/* /fonts/* /home/fonts/* /og/* /brand/* /evidencia /evidencia/*
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# The evidence layer, served from the `ancla` service in this project over
	# Railway's private network.
	#
	# A path on this domain rather than a subdomain, because the two are one
	# argument: the site claims a record is being kept, and /evidencia is where a
	# reader checks that claim without leaving. handle_path strips the prefix, so
	# the upstream is unaware it is mounted and the same export still works
	# standalone — which matters, because the whole point of it being static
	# files is that anyone can host their own copy.
	#
	# Nothing sensitive rides on this hop. The pages recompute their digests in
	# the reader's browser and read commitments straight off a public
	# DecentralChain node, so a compromised proxy changes what a reader sees and
	# not what they can prove.
	handle_path /evidencia* {
		reverse_proxy http://ancla.railway.internal:8080
	}

	# Routes are directories holding an index.html. No fallback to the home page:
	# that is the behaviour this file exists to remove.
	handle {
		try_files {path} {path}/index.html
		file_server
	}

	# A miss served Caddy's empty body. The status was right and the page was
	# blank, which is a worse answer than the status alone.
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}
